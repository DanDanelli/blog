<mxfile host="app.diagrams.net"><diagram id="per-user-access" name="Per-user access to tools"><mxGraphModel dx="1460" dy="860" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;How each user&#x27;s identity reaches the tools&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Production shape · November 2026&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1100" height="55" as="geometry" /></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;Only people assigned to the application can sign in.&lt;br&gt;Issues the token that says who the user is" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#E8F0FE;strokeColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="480" height="60" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;Claude Desktop&lt;br&gt;signed in as themselves" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#F4F5F7;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="170" height="110" as="geometry" /></mxCell><mxCell id="aws" value="&lt;b&gt;AWS · AgentCore&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="205" width="570" height="325" as="geometry" /></mxCell><mxCell id="gw" value="&lt;b&gt;3 · AgentCore Gateway&lt;/b&gt;&lt;br&gt;Checks the token and learns who is asking" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="155" height="130" as="geometry" /></mxCell><mxCell id="cedar" value="&lt;b&gt;4 · Cedar policies&lt;/b&gt;&lt;br&gt;Is this tool permitted?&lt;br&gt;&lt;b&gt;Same list for everyone&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#FFF4DC;strokeColor=#E0A800;" vertex="1" parent="1"><mxGeometry x="505" y="260" width="155" height="130" as="geometry" /></mxCell><mxCell id="identity" value="&lt;b&gt;5 · AgentCore Identity&lt;/b&gt;&lt;br&gt;Gets the token for this person and this system. Its vault keeps them per person" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#E8F0FE;strokeColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="680" y="260" width="180" height="130" as="geometry" /></mxCell><mxCell id="portal" value="&lt;b&gt;Consent portal&lt;/b&gt;&lt;br&gt;The person signs in to the vendor and authorizes once" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#01A88D;dashed=1;" vertex="1" parent="1"><mxGeometry x="680" y="450" width="180" height="70" as="geometry" /></mxCell><mxCell id="m365" value="&lt;b&gt;SharePoint and Microsoft 365&lt;/b&gt;&lt;br&gt;Token comes from an exchange with Entra, no extra consent&lt;br&gt;Agent may read and write, including sharing links&lt;br&gt;&lt;b&gt;Applies this person&#x27;s SharePoint permissions&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#E8F0FE;strokeColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="985" y="120" width="375" height="120" as="geometry" /></mxCell><mxCell id="atl" value="&lt;b&gt;Atlassian&lt;/b&gt;&lt;br&gt;Token comes from the person&#x27;s one-time consent&lt;br&gt;Agent may read and write; destructive actions withheld&lt;br&gt;&lt;b&gt;Applies this person&#x27;s Atlassian permissions&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#E8F0FE;strokeColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="985" y="265" width="375" height="120" as="geometry" /></mxCell><mxCell id="lx" value="&lt;b&gt;SAP LeanIX&lt;/b&gt;&lt;br&gt;Token comes from the person&#x27;s one-time consent&lt;br&gt;Agent may only read&lt;br&gt;&lt;b&gt;Applies this person&#x27;s LeanIX permissions&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#E8F0FE;strokeColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="985" y="410" width="375" height="120" as="geometry" /></mxCell><mxCell id="e1" value="1 · sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="entra"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="2 · tool request,&lt;br&gt;with the user&#x27;s token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="gw"><mxGeometry relative="1" as="geometry"><mxPoint x="-13" y="-28" as="offset" /></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="cedar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cedar" target="identity"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="exchange for a Graph token,&lt;br&gt;Microsoft 365 only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1A73E8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7708;entryY=1;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="identity" target="entra"><mxGeometry relative="1" as="geometry" x="0.42" /></mxCell><mxCell id="e6a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="identity" target="m365"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="325" /><mxPoint x="930" y="180" /></Array></mxGeometry></mxCell><mxCell id="e6b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="identity" target="atl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="identity" target="lx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="325" /><mxPoint x="930" y="470" /></Array></mxGeometry></mxCell><mxCell id="l6" value="6 · call&lt;br&gt;as the user" style="text;html=1;whiteSpace=wrap;fontColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="890" y="232" width="80" height="34" as="geometry" /></mxCell><mxCell id="e7" value="First use only, Atlassian and LeanIX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="portal"><mxGeometry relative="1" as="geometry" x="0.3"><Array as="points"><mxPoint x="115" y="485" /></Array></mxGeometry></mxCell><mxCell id="e8" value="stores the grant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal" target="identity"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fh" value="&lt;b&gt;Three filters on every request&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="555" width="500" height="26" as="geometry" /></mxCell><mxCell id="f1" value="&lt;b&gt;Entry · Entra · per person&lt;/b&gt;&lt;br&gt;Whether this person can use the platform at all" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#E8F0FE;strokeColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="30" y="583" width="435" height="60" as="geometry" /></mxCell><mxCell id="f2" value="&lt;b&gt;Tools · Cedar · same for everyone&lt;/b&gt;&lt;br&gt;What the agent can do in each system" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#FFF4DC;strokeColor=#E0A800;" vertex="1" parent="1"><mxGeometry x="477" y="583" width="435" height="60" as="geometry" /></mxCell><mxCell id="f3" value="&lt;b&gt;Data · the system itself · per person&lt;/b&gt;&lt;br&gt;What this person sees and changes. The granularity lives here" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#E8F0FE;strokeColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="924" y="583" width="435" height="60" as="geometry" /></mxCell><mxCell id="ex" value="&lt;b&gt;Same request, different result&lt;/b&gt;&lt;br&gt;Two people ask for a summary of document X. If only one of them has access to it in SharePoint, only that person gets the summary. The platform opens nothing the person could not already open." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#F4F5F7;strokeColor=#9AA5B1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="500" height="105" as="geometry" /></mxCell><mxCell id="lim" value="&lt;b&gt;Limits of this model&lt;/b&gt;&lt;br&gt;· Broad permissions stay broad, and the agent makes what they expose easier to find.&lt;br&gt;· The agent can act within a person&#x27;s permissions but against their intent. The sharing link is the sensitive case (risk accepted).&lt;br&gt;· Removing someone from the group refuses new sign-ins. How long the connector keeps working is not yet measured." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#F4F5F7;strokeColor=#9AA5B1;align=left;" vertex="1" parent="1"><mxGeometry x="542" y="660" width="818" height="105" as="geometry" /></mxCell><mxCell id="foot" value="&lt;font color=&quot;#5F6B7A&quot;&gt;Simplified: the OAuth shim and the interceptor are omitted. Neither changes whose identity a call carries.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="772" width="1000" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>