<mxfile host="drawio">
  <diagram id="apps-gateway" name="With Claude apps gateway">
    <mxGraphModel dx="1560" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="920" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        
        <mxCell id="title" value="&lt;b&gt;How a request travels&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Production shape · one AWS region in the EU · November 2026&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="555" height="44" as="geometry" />
        </mxCell>

        
        <mxCell id="user" value="Employee" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#1A73E8;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="40" y="315" width="50" height="50" as="geometry" />
        </mxCell>

        
        <mxCell id="shim" value="&lt;b&gt;OAuth shim&lt;/b&gt;&lt;br&gt;API Gateway HTTP API&lt;br&gt;company hostname · TLS&lt;br&gt;serves OAuth discovery, relays sign-in;&lt;br&gt;forwards /mcp unchanged" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="440" y="475" width="60" height="60" as="geometry" />
        </mxCell>

        
        <mxCell id="agentcore" value="&lt;b&gt;Amazon Bedrock AgentCore&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Path A — tools; outside the Claude Apps Gateway&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="410" width="330" height="270" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;validates the user&#x27;s&lt;br&gt;Entra JWT&lt;br&gt;3 targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#017A66;fontColor=#FFFFFF;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="615" y="465" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;Policy engine&lt;/b&gt;&lt;br&gt;Cedar · enforced&lt;br&gt;allowed per tool;&lt;br&gt;no policy = denied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontColor=#232F3E;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="795" y="465" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;token vault&lt;br&gt;OBO for Graph;&lt;br&gt;3LO for Atlassian, LeanIX&lt;br&gt;first use: consent portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontColor=#232F3E;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="795" y="575" width="120" height="94" as="geometry" />
        </mxCell>

        
        <mxCell id="lambda" value="&lt;b&gt;Interceptor (Lambda)&lt;/b&gt;&lt;br&gt;runs on every tool call;&lt;br&gt;request passed through unchanged&lt;br&gt;logs which operation ran behind&lt;br&gt;Atlassian&#x27;s executeRead / executeWrite" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="470" y="645" width="60" height="60" as="geometry" />
        </mxCell>

        
        <mxCell id="cloudwatch" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt; — gateway, interceptor and shim logs&lt;br&gt;&lt;b&gt;X-Ray&lt;/b&gt; — traces (Transaction Search)&lt;br&gt;account data protection policy masks JWTs, bearer tokens&lt;br&gt;and secrets &lt;b&gt;on read&lt;/b&gt;; the value stays stored, readable with logs:Unmask" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="735" y="770" width="60" height="60" as="geometry" />
        </mxCell>

        
        <mxCell id="third" value="&lt;b&gt;Third-party systems&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;each applies the user&#x27;s own permissions&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F6F7;strokeColor=#5F6B7A;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1010" y="388" width="210" height="315" as="geometry" />
        </mxCell>
        <mxCell id="m365" value="&lt;b&gt;Microsoft 365 (Graph)&lt;/b&gt;&lt;br&gt;SharePoint · Excel&lt;br&gt;OpenAPI target · REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontColor=#232F3E;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1025" y="453" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="atlassian" value="&lt;b&gt;Atlassian Cloud&lt;/b&gt;&lt;br&gt;Jira · Confluence&lt;br&gt;vendor&#x27;s MCP server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontColor=#232F3E;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1025" y="533" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="leanix" value="&lt;b&gt;SAP LeanIX&lt;/b&gt;&lt;br&gt;vendor&#x27;s MCP server&lt;br&gt;read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontColor=#232F3E;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1025" y="613" width="180" height="70" as="geometry" />
        </mxCell>

        
        <mxCell id="note" value="&lt;b&gt;Per-person control on model usage&lt;/b&gt;&lt;br&gt;&lt;br&gt;• All model traffic crosses one component we run: &lt;b&gt;models by Entra App Role, spend caps per person&lt;/b&gt;, enforced at the gateway.&lt;br&gt;• Attribution: the gateway&#x27;s spend tables, and the bill (CUR 2.0) through each person&#x27;s role session.&lt;br&gt;&lt;br&gt;&lt;b&gt;Still open&lt;/b&gt;&lt;br&gt;• The network path for devices outside MDM." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#E0A800;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="565" width="340" height="205" as="geometry" />
        </mxCell>

        
        <mxCell id="e1" value="5 connector sign-in (PKCE)&lt;br&gt;tool-plane token" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.23;entryY=0;" edge="1" parent="1" source="entra2" target="claude2">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        
        <mxCell id="e4" value="6 MCP over HTTPS&lt;br&gt;tool-plane JWT" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="claude2" target="shim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="shim" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pol" value="every call" style="html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#E6F6F3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gateway" target="policy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-id" value="user token" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#E6F6F3;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="gateway" target="identity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-int" value="every tool call" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#ED7100;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="gateway" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="8 as the user" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="agentcore" target="third">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e-log" value="logs + traces" style="html=1;endArrow=block;endFill=1;strokeColor=#E7157B;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="agentcore" target="cloudwatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      <mxCell id="pathB2" value="&lt;b&gt;Path B — model.&lt;/b&gt; Every model request crosses the Claude Apps Gateway, &lt;b&gt;on a private address only.&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F2FBF9;strokeColor=#01A88D;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="580" y="30" width="860" height="340" as="geometry" /></mxCell><mxCell id="vpc" value="&lt;b&gt;Gateway VPC&lt;/b&gt; · two AZs · private subnets · Transit Gateway" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="600" y="64" width="500" height="290" as="geometry" /></mxCell><mxCell id="entra2" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;confidential app&lt;br&gt;for the gateway;&lt;br&gt;App Roles select the tier" style="image;aspect=fixed;html=1;points=[];fontSize=12;fontColor=#232F3E;image=img/lib/azure2/identity/Azure_Active_Directory.svg;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="175" y="60" width="70" height="64" as="geometry" /></mxCell><mxCell id="claude2" value="&lt;b&gt;Claude Desktop (Cowork) · Claude Code&lt;/b&gt;&lt;br&gt;managed or unmanaged device&lt;br&gt;one setting: the gateway&#x27;s bootstrap URL&lt;br&gt;models, connector, policy: from the gateway&lt;br&gt;&lt;b&gt;no AWS credentials on the device&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D97757;strokeColor=#B85C3E;fontColor=#FFFFFF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="160" y="285" width="250" height="110" as="geometry" /></mxCell><mxCell id="net" value="&lt;b&gt;Corporate network&lt;/b&gt;&lt;br&gt;Direct Connect and&lt;br&gt;Transit Gateway" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 3;fillColor=#FFF8E6;strokeColor=#E0A800;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="438" y="300" width="122" height="80" as="geometry" /></mxCell><mxCell id="steps" value="1 sign-in (device code), config&lt;br&gt;3 model requests, session token" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="398" y="250" width="168" height="40" as="geometry" /></mxCell><mxCell id="alb" value="&lt;b&gt;Internal ALB&lt;/b&gt;&lt;br&gt;ACM certificate&lt;br&gt;internal DNS (CNAME)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;fillColor=#8C4FFF;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="60" height="60" as="geometry" /></mxCell><mxCell id="gw2" value="&lt;b&gt;Claude Apps Gateway&lt;/b&gt;&lt;br&gt;ECS Fargate&lt;br&gt;sign-in · session · bootstrap&lt;br&gt;models by App Role, spend caps per person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#B85C00;fontColor=#FFFFFF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="750" y="160" width="170" height="100" as="geometry" /></mxCell><mxCell id="nat" value="&lt;b&gt;NAT gateway&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.nat_gateway;fillColor=#8C4FFF;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="745" y="92" width="44" height="44" as="geometry" /></mxCell><mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL&lt;/b&gt;&lt;br&gt;sign-in, rate limits, spend" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="985" y="84" width="50" height="50" as="geometry" /></mxCell><mxCell id="sm" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;OIDC secret, JWT key, DB URL" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#DD344C;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="985" y="222" width="50" height="50" as="geometry" /></mxCell><mxCell id="role" value="&lt;b&gt;Task role → per-person session&lt;/b&gt;&lt;br&gt;assume_role&lt;br&gt;session name = the user" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1155" y="185" width="50" height="50" as="geometry" /></mxCell><mxCell id="bedrock2" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;model ids mapped at the gateway&lt;br&gt;Opus · Sonnet · Haiku&lt;br&gt;EU regions only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#017A66;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="72" width="210" height="84" as="geometry" /></mxCell><mxCell id="cw2" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;audit log, masked on read&lt;br&gt;claude_code.* metrics, no identity" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1140" y="297" width="50" height="50" as="geometry" /></mxCell><mxCell id="retired" value="&lt;b&gt;Retired by this design&lt;/b&gt;&lt;br&gt;the per-device package: credential helper, AWS profile, federated role, model list.&lt;br&gt;&lt;b&gt;Closing the old federated role&lt;/b&gt; is what makes the caps binding" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F6F7;strokeColor=#5F6B7A;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="20" y="425" width="205" height="125" as="geometry" /></mxCell><mxCell id="e-c-net" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="claude2" target="net"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-net-alb" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="net" target="alb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="340" /><mxPoint x="570" y="210" /></Array></mxGeometry></mxCell><mxCell id="e-alb-gw" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="alb" target="gw2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-gw-nat" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;exitX=0.1;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="gw2" target="nat"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-nat-entra" value="2 OIDC sign-in, gateway&#x27;s own client" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="nat" target="entra2"><mxGeometry relative="1" as="geometry" x="0.35"><Array as="points"><mxPoint x="330" y="114" /><mxPoint x="330" y="92" /></Array></mxGeometry></mxCell><mxCell id="e-gw-rds" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#C925D1;exitX=0.85;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw2" target="rds"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-gw-sm" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DD344C;exitX=1;exitY=0.87;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw2" target="sm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-gw-role" value="4 SigV4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw2" target="role"><mxGeometry relative="1" as="geometry" x="0.62" /></mxCell><mxCell id="e-role-br" value="InvokeModel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="role" target="bedrock2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-gw-cw" value="audit events (stderr)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#E7157B;fontSize=10;exitX=0.15;exitY=1;entryX=0;entryY=0.85;" edge="1" parent="1" source="gw2" target="cw2"><mxGeometry relative="1" as="geometry" x="0.55"><Array as="points"><mxPoint x="775" y="340" /></Array></mxGeometry></mxCell><mxCell id="e-user2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;" edge="1" parent="1" source="user" target="claude2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="otel" value="&lt;b&gt;OTel Collector&lt;/b&gt; (contrib)&lt;br&gt;sidecar in the gateway task&lt;br&gt;allow-list of labels" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#ED7100;fontColor=#232F3E;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="278" width="125" height="50" as="geometry" /></mxCell><mxCell id="e-gw-otel" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#E7157B;exitX=0.647;exitY=1;entryX=0.48;entryY=0;" edge="1" parent="1" source="gw2" target="otel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-otel-cw" value="EMF" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#E7157B;exitX=1;exitY=0.68;entryX=0;entryY=0.3;" edge="1" parent="1" source="otel" target="cw2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cur" value="&lt;b&gt;CUR 2.0 export&lt;/b&gt;&lt;br&gt;the bill, next day&lt;br&gt;per person, by session name" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontColor=#232F3E;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1290" y="226" width="140" height="56" as="geometry" /></mxCell><mxCell id="e-br-cur" value="usage" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;fontSize=10;labelBackgroundColor=#F2FBF9;strokeColor=#01A88D;exitX=0.85;exitY=1;entryX=0.736;entryY=0;" edge="1" parent="1" source="bedrock2" target="cur"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="why" value="&lt;b&gt;Why these two components&lt;/b&gt;&lt;br&gt;&lt;b&gt;OAuth shim:&lt;/b&gt; Claude&#x27;s connector sign-in expects OAuth features that Entra does not provide, and Entra accepts only identifiers on verified domains, which the gateway&#x27;s AWS address is not. The shim fills that gap under a company hostname. It handles sign-in only; tool traffic passes straight through.&lt;br&gt;&lt;b&gt;Interceptor:&lt;/b&gt; Atlassian exposes about 300 operations behind three generic tools, so Cedar and the gateway logs see only the generic name. The interceptor records which operation ran and changes nothing in the request." vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#1A73E8;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;"><mxGeometry x="20" y="795" width="690" height="105" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>